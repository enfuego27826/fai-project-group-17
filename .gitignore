# Gurobi licence: never commit
*.lic
gurobi.lic

.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Raw run outputs (per-run JSON, policies, solutions) stay local; keep the small files the
# report and the figures are built from
results/**
!results/**/
!results/**/summary*
!results/**/metrics.json
!results/**/config.yaml
!results/**/run_info.json
!results/**/targets.json
!results/**/analysis.*
!results/**/*.csv
!results/**/learned_bits.txt
!results/**/v_com.json

# LaTeX build files
*.aux
*.bbl
*.blg
*.log
*.out
*.pdf

# Team-internal milestone notes and run logs (not published)
notes/

# Report build files are ignored above (*.pdf); keep the report's own PDF and figures
!report/main.pdf
!report/figures/*.pdf

# Local tool state
.claude/
.ruff_cache/
.mypy_cache/
